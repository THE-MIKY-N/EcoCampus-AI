# Configuración general de Django
DJANGO_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_SEGURA
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base de datos SQL Server local
DJANGO_USE_SUPABASE=False
DB_NAME=EcoCampusAI
DB_HOST=localhost
DB_PORT=
DB_DRIVER=ODBC Driver 18 for SQL Server

# Configuración alternativa para Supabase
# DJANGO_USE_SUPABASE=True
# SUPABASE_DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/postgres
